# Copy to .env for local runs. Never commit .env. All values are placeholders.

PORT=3000
LOG_LEVEL=info

# Shared HMAC key with the event source (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=<generate-a-random-32+-char-value>
SIGNATURE_TOLERANCE_SEC=300
BODY_LIMIT=100kb

# ServiceNow target
SN_INSTANCE_URL=https://your-instance.service-now.com
# Only for the local mock (plain http). Leave false for real instances.
SN_ALLOW_HTTP=false

# oauth (client credentials, recommended) | basic
SN_AUTH_MODE=oauth
SN_CLIENT_ID=<your-oauth-client-id>
SN_CLIENT_SECRET=<your-oauth-client-secret>
# Basic auth (only if SN_AUTH_MODE=basic)
SN_USERNAME=<integration-user>
SN_PASSWORD=<set-in-your-secret-store>

# import_set (staging table + transform map) | table (direct Table API upsert)
SN_WRITE_MODE=import_set
SN_IMPORT_TABLE=u_monitoring_event_import
SN_INCIDENT_TABLE=incident
SN_HR_CASE_TABLE=sn_hr_core_case
SN_TIMEOUT_MS=10000

# Resilience
RETRY_MAX=4
RETRY_BASE_MS=250
RETRY_MAX_MS=8000
CB_FAILURE_THRESHOLD=5
CB_RESET_MS=30000
IDEMPOTENCY_TTL_MS=86400000

# Dead-letter queue: memory | file
DLQ_MODE=file
DLQ_FILE=./data/dlq.jsonl

# Enables /admin/dlq endpoints when set (leave empty to disable)
ADMIN_TOKEN=<generate-a-random-admin-token>
