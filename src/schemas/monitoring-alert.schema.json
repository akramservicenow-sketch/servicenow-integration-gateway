{
  "$id": "https://github.com/akramservicenow-sketch/servicenow-integration-gateway/schemas/monitoring-alert.json",
  "title": "Monitoring alert webhook",
  "description": "Alert emitted by an external monitoring tool. Only these fields are accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "source", "host", "check", "severity", "status", "summary", "occurred_at"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._:-]+$" },
    "source": { "type": "string", "minLength": 1, "maxLength": 50 },
    "host": { "type": "string", "minLength": 1, "maxLength": 255 },
    "check": { "type": "string", "minLength": 1, "maxLength": 100 },
    "severity": { "enum": ["critical", "major", "minor", "warning", "info"] },
    "status": { "enum": ["firing", "resolved"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 4000 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "assignment_group": { "type": "string", "maxLength": 80 },
    "tags": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": { "type": "string", "maxLength": 100 }
    }
  }
}
